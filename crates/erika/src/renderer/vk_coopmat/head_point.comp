// A 1x1 head has no spatial reuse: shared staging and barriers only add work.
// Specialize graph descriptors so the driver can unroll constant FMA operands.
void main() {
    const uint descriptors[64]=uint[](D0,D1,D2,D3,D4,D5,D6,D7,D8,D9,D10,D11,D12,D13,D14,D15,D16,D17,D18,D19,D20,D21,D22,D23,D24,D25,D26,D27,D28,D29,D30,D31,D32,D33,D34,D35,D36,D37,D38,D39,D40,D41,D42,D43,D44,D45,D46,D47,D48,D49,D50,D51,D52,D53,D54,D55,D56,D57,D58,D59,D60,D61,D62,D63);
    uvec2 pos=p.region.xy+gl_GlobalInvocationID.xy;
    if(any(greaterThanEqual(pos,p.region.xy+p.region.zw)) || any(greaterThanEqual(pos,p.size.zw))) return;
    vec4 acc=vec4(0.0);
    [[unroll]] for(uint operandIndex=0;operandIndex<H14;++operandIndex) {
        uint base=descriptors[operandIndex*4],transform=descriptors[operandIndex*4+1];
        uint channels=descriptors[operandIndex*4+2],coefficients=descriptors[operandIndex*4+3];
        [[unroll]] for(uint c=0;c<channels;++c) {
            float v=float(features[feature_index(base+c,pos.y*p.size.z+pos.x)]);
            v=transform==1 ? max(v,0.0) : transform==2 ? max(-v,0.0) : v;
            acc=fma(vec4(v),headWeights[coefficients+c],acc);
        }
    }
    [[unroll]] for(uint c=0;c<4;++c) epilogue(acc[c],c,pos.y*p.size.z+pos.x,0);
}
