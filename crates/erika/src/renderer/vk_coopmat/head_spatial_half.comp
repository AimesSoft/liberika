layout(constant_id=57) const uint D25=0;
layout(constant_id=58) const uint D26=0;
layout(constant_id=59) const uint D27=0;
layout(constant_id=60) const uint D28=0;
layout(constant_id=61) const uint D29=0;
layout(constant_id=62) const uint D30=0;
layout(constant_id=63) const uint D31=0;
layout(constant_id=64) const uint D32=0;
layout(constant_id=65) const uint D33=0;
layout(constant_id=66) const uint D34=0;
layout(constant_id=67) const uint D35=0;
layout(constant_id=68) const uint D36=0;
