layout(constant_id=92) const uint D60=0;
layout(constant_id=93) const uint D61=0;
layout(constant_id=94) const uint D62=0;
layout(constant_id=95) const uint D63=0;
shared float16_t tile[16*((8+MAX_KERNEL-1)*(8+MAX_KERNEL-1)+1)];
void main() {
    const uint descriptors[64]=uint[](D0,D1,D2,D3,D4,D5,D6,D7,D8,D9,D10,D11,D12,D13,D14,D15,D16,D17,D18,D19,D20,D21,D22,D23,D24,D25,D26,D27,D28,D29,D30,D31,D32,D33,D34,D35,D36,D37,D38,D39,D40,D41,D42,D43,D44,D45,D46,D47,D48,D49,D50,D51,D52,D53,D54,D55,D56,D57,D58,D59,D60,D61,D62,D63);
    uvec2 start=p.region.xy+gl_WorkGroupID.xy*8;
    uvec2 pos=start+gl_LocalInvocationID.xy;
    const uint side=8+MAX_KERNEL-1,area=side*side,pitch=area+1;
    f16vec4 acc=f16vec4(0.0);
    [[unroll]] for(uint operandIndex=0;operandIndex<H14/(MAX_KERNEL*MAX_KERNEL);++operandIndex) {
        uint base=descriptors[operandIndex*4],transform=descriptors[operandIndex*4+1];
        uint channels=descriptors[operandIndex*4+2],coefficients=descriptors[operandIndex*4+3];
        [[unroll]] for(uint c0=0;c0<channels;c0+=16) {
            uint count=min(16,channels-c0);
            for(uint i=gl_LocalInvocationIndex;i<count*area;i+=64) {
                ivec2 at=ivec2(start+uvec2((i/count)%side,(i/count)/side))-ivec2(MAX_KERNEL/2);
                float v=0.0;
                if(all(greaterThanEqual(at,ivec2(0))) && all(lessThan(at,ivec2(p.size.zw))))
                    v=float(features[feature_index(base+c0+i%count,uint(at.y)*p.size.z+uint(at.x))]);
                tile[(i%count)*pitch+i/count]=float16_t(transform==1 ? max(v,0.0) : transform==2 ? max(-v,0.0) : v);
            }
            barrier();
            [[unroll]] for(uint c=0;c<count;++c)
            [[unroll]] for(uint ky=0;ky<MAX_KERNEL;++ky) [[unroll]] for(uint kx=0;kx<MAX_KERNEL;++kx) {
                float16_t v=tile[c*pitch+(gl_LocalInvocationID.y+ky)*side+gl_LocalInvocationID.x+kx];
                uvec2 packed=headPacked[coefficients+((c0+c)*MAX_KERNEL+ky)*MAX_KERNEL+kx].xy;
                f16vec4 weight=f16vec4(unpackFloat2x16(packed.x),unpackFloat2x16(packed.y));
                acc=fma(f16vec4(v),weight,acc);
            }
            barrier();
        }
    }
    if(all(lessThan(pos,p.region.xy+p.region.zw)) && all(lessThan(pos,p.size.zw)))
        [[unroll]] for(uint c=0;c<4;++c) epilogue(float(acc[c]),c,pos.y*p.size.z+pos.x,0);
}
