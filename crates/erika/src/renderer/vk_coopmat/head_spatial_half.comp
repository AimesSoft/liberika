#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
#define SPECIALIZED_LAYER
#include "common.glsl"
// Four fp16 coefficients occupy the first two words of each 16-byte slot.
// Channel-contiguous global loads transpose into a padded fp16 shared tile.
layout(set=0,binding=5,std140) uniform HeadWeights { uvec4 headPacked[1024]; };
layout(constant_id=4) const uint MAX_KERNEL=5;
layout(local_size_x=8,local_size_y=8) in;
layout(constant_id=32) const uint D0=0;
layout(constant_id=33) const uint D1=0;
